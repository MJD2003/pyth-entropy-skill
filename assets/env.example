# ═══════════════════════════════════════════════════════════
# Pyth Entropy v2 — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Network ──────────────────────────────────────────────
# RPC endpoint for your target chain
RPC_URL=https://sepolia.optimism.io

# ─── Wallet ───────────────────────────────────────────────
# Private key for deploying and interacting (no 0x prefix needed for some tools)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── Entropy Contract ────────────────────────────────────
# Find your chain's address at: https://docs.pyth.network/entropy/chainlist
#
# Common mainnet addresses:
#   Optimism / Base / Mode:    0x4821932D0CDd71225A6d914706A621e0389D7061
#   Ethereum / Arbitrum / etc: 0x549Ebba8036Ab86D79D9deFba1A495D0710C0983
#   Blast:                     0x5744Cbf430D99456a0A8771208b674F27f8EF0Fb
#
# Common testnet addresses:
#   Optimism Sepolia / Base Sepolia: 0x4821932D0CDd71225A6d914706A621e0389D7061
#   Arbitrum Sepolia / Sepolia:      0x549Ebba8036Ab86D79D9deFba1A495D0710C0983
#
ENTROPY_ADDRESS=0x4821932D0CDd71225A6d914706A621e0389D7061

# ─── Your Deployed Consumer Contract ─────────────────────
# Set this after deploying your consumer contract
CONSUMER_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_HERE

# ─── Optional: Etherscan/Block Explorer API Key ──────────
# For contract verification
ETHERSCAN_API_KEY=

# ─── Optional: Custom Provider ───────────────────────────
# Default mainnet:  0x52DeaA1c84233F7bb8C8A45baeDE41091c616506
# Default testnet:  0x6CC14824Ea2918f5De5C2f75A9Da968ad4BD6344
# Only set if using a non-default provider
# ENTROPY_PROVIDER=
